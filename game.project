[bootstrap]
main_collection = /tests/divisions_gold/divisions_gold.collectionc

[script]
shared_state = 1

[display]
width = 1080
height = 2300
high_dpi = 0

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch

[project]
title = defigma
dependencies#0 = https://github.com/defold/extension-automation-bridge/archive/refs/tags/2.0.2.zip
dependencies#1 = https://github.com/Insality/defold-event/archive/refs/tags/14.zip

[library]
include_dirs = defigma

[automation_bridge]
application_api = 1

